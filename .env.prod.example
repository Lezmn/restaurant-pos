# ค่าสำหรับ docker-compose.prod.yml — คัดลอกเป็น .env ที่โฟลเดอร์ราก แล้วแก้ทุกค่าที่มี <...>
#   cp .env.prod.example .env
# ห้าม commit .env (มีรหัส DB และ JWT_SECRET)

# ---- โดเมน (DNS ทั้งสองต้องชี้มาที่เครื่องนี้ก่อน up) ----
APP_DOMAIN=<pos.ร้าน.com>
API_DOMAIN=<api.ร้าน.com>
# อีเมลรับแจ้งเตือนจาก Let's Encrypt (ใบรับรองใกล้หมดอายุ/มีปัญหา)
ACME_EMAIL=<owner@ร้าน.com>

# ---- ฐานข้อมูล ----
POSTGRES_USER=restaurant
# hex เท่านั้น — base64 มี / + = ที่ทำให้ DATABASE_URL เพี้ยน
POSTGRES_PASSWORD=<สุ่มใหม่: openssl rand -hex 24>
POSTGRES_DB=restaurant_db

# ---- API ----
JWT_SECRET=<สุ่มใหม่: openssl rand -hex 48>
JWT_EXPIRES_IN=8h
TZ=Asia/Bangkok
# rate limit ต่อบัญชี (บัญชีกลางใช้หลายเครื่อง นับรวมกัน) — ~36 ครั้ง/นาที/เครื่อง ตอนเปิดหน้าทิ้งไว้
THROTTLE_LIMIT=600
THROTTLE_IP_LIMIT=1000

# ---- ตรวจสลิป PromptPay (ไม่ตั้ง = สลิปค้าง "รอตรวจ" ต้องให้ ADMIN ยืนยันเอง) ----
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# ---- หน้าเว็บ (ฝังตอน build — เปลี่ยนแล้วต้อง up --build ใหม่) ----
# ไม่ตั้ง = หน้ารับเงินไม่สร้าง QR พร้อมเพย์ (กันเงินเข้าเบอร์คนอื่น)
VITE_PROMPTPAY_ID=<เบอร์มือถือหรือเลขผู้เสียภาษี 13 หลักของร้าน>
VITE_RESTAURANT_NAME=<ชื่อร้าน>
VITE_LOGIN_EMAIL_DOMAIN=restaurant.local
# เวลาเปิด–ปิดร้าน (0-23) สำหรับ heatmap หน้ายอดขาย — CLOSE = ชั่วโมงสุดท้ายที่รับออเดอร์ · ไม่ตั้ง = ตัดตามข้อมูล
VITE_OPEN_HOUR=
VITE_CLOSE_HOUR=

# ---- สำรองข้อมูล ----
# ทุกวันกี่โมง (เวลาไทย, 00-23) และเก็บย้อนหลังกี่วัน — ไฟล์อยู่ที่ ./backups
BACKUP_HOUR=03
BACKUP_KEEP_DAYS=14
# healthchecks.io — ping ทุกครั้งที่สำรองเสร็จ ถ้าเงียบเกินกำหนด (Period 1 วัน + Grace 2 ชม.) ส่งอีเมลเตือน
BACKUP_PING_URL=

# ---- สำรองนอกเครื่อง (service "offsite" — ตั้ง remote ก่อน ดู docs/OPERATIONS.md) ----
# เปิดใช้: COMPOSE_PROFILES=offsite
COMPOSE_PROFILES=
# ชื่อ remote ที่ตั้งใน rclone config + โฟลเดอร์ปลายทาง
RCLONE_REMOTE=gdrive:restaurant-backups
OFFSITE_EVERY_MIN=60
# เก็บนอกเครื่องนานกว่าในเครื่อง — กรณีรู้ตัวช้าว่าข้อมูลเสีย
OFFSITE_KEEP_DAYS=90
# healthchecks.io อีกตัวสำหรับการคัดลอกออกนอกเครื่อง (Period 1 ชม. + Grace 1 ชม.)
OFFSITE_PING_URL=

# ---- พอร์ต (ปกติไม่ต้องแก้) ----
HTTP_PORT=80
HTTPS_PORT=443
