# ค่าสำหรับ docker-compose.prod.yml — คัดลอกเป็น .env ที่โฟลเดอร์ราก แล้วแก้ทุกค่าที่มี <...>
#   cp .env.prod.example .env
# ห้าม commit .env (มีรหัส DB และ JWT_SECRET)

# ---- โดเมน (DNS ทั้งสองต้องชี้มาที่เครื่องนี้ก่อน up) ----
APP_DOMAIN=<pos.ร้าน.com>
API_DOMAIN=<api.ร้าน.com>
# อีเมลรับแจ้งเตือนจาก Let's Encrypt (ใบรับรองใกล้หมดอายุ/มีปัญหา)
ACME_EMAIL=<owner@ร้าน.com>

# ---- ฐานข้อมูล ----
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=<สุ่มใหม่: openssl rand -base64 24>
POSTGRES_DB=restaurant_db

# ---- API ----
JWT_SECRET=<สุ่มใหม่: openssl rand -base64 48>
JWT_EXPIRES_IN=8h
TZ=Asia/Bangkok
# rate limit ต่อบัญชี (บัญชีกลางใช้หลายเครื่อง นับรวมกัน) — ~36 ครั้ง/นาที/เครื่อง ตอนเปิดหน้าทิ้งไว้
THROTTLE_LIMIT=600
THROTTLE_IP_LIMIT=1000

# ---- ตรวจสลิป PromptPay (ไม่ตั้ง = สลิปค้าง "รอตรวจ" ต้องให้ ADMIN ยืนยันเอง) ----
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# ---- หน้าเว็บ (ฝังตอน build — เปลี่ยนแล้วต้อง up --build ใหม่) ----
# ไม่ตั้ง = หน้ารับเงินไม่สร้าง QR พร้อมเพย์ (กันเงินเข้าเบอร์คนอื่น)
VITE_PROMPTPAY_ID=<เบอร์มือถือหรือเลขผู้เสียภาษี 13 หลักของร้าน>
VITE_RESTAURANT_NAME=<ชื่อร้าน>
VITE_LOGIN_EMAIL_DOMAIN=restaurant.local

# ---- สำรองข้อมูล ----
# ทุกวันกี่โมง (เวลาไทย, 00-23) และเก็บย้อนหลังกี่วัน — ไฟล์อยู่ที่ ./backups
BACKUP_HOUR=03
BACKUP_KEEP_DAYS=14

# ---- พอร์ต (ปกติไม่ต้องแก้) ----
HTTP_PORT=80
HTTPS_PORT=443
