# ค่าจริงของ production (docker-compose.prod.yml อ่านจากไฟล์นี้) — มีรหัส DB และ JWT_SECRET
.env
.env.*
!.env.prod.example

# ไฟล์สำรองฐานข้อมูลจาก service backup — ข้อมูลร้านจริง ห้ามเข้า git
backups/
# รูปเมนูที่อัปโหลดตอน dev (production อยู่บนโฟลเดอร์ ~/app/uploads ของ VPS)
backend/uploads/
# rclone.conf มี token ของบัญชี cloud ที่เก็บไฟล์สำรองนอกเครื่อง + ไฟล์ที่ดึงกลับมาซ้อมกู้
deploy/rclone/
offsite-check/

# ผล test coverage (สร้างใหม่ทุกครั้งที่รัน — Sonar อ่านจากไฟล์นี้)
coverage/

# Claude Code — ค่าตั้งส่วนตัวของแต่ละเครื่อง และสำเนา repo ชั่วคราวของ session อื่น
# (agents/skills ใน .claude/ ยังเก็บใน git ให้คนที่ clone ใช้ได้)
.claude/settings.local.json
.claude/worktrees/
# dev server ที่ชี้ path ในเครื่องตัวเอง
.claude/launch.json

# binary ของ impeccable skill (~20 MB) — ได้มาเองตอนติดตั้ง plugin ไม่เก็บใน history
.claude/skills/impeccable/scripts/bin/
